    "hono": "^4.10.6",
    "@hono/node-server": "^1.13.7",
    "lucide-react": "^0.554.0",
    "marked": "^17.0.1",
    "marked-highlight": "^2.2.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.6",
    "satori": "^0.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@hono/vite-dev-server": "^0.23.0",
