    "type": "git",
    "url": "https://github.com/ShinChven/neon-fragments-cyberpunk-blog.git"
  },
  "scripts": {
    "dev": "vite",
    "build:content": "tsx scripts/build-content.ts",
    "build:client": "vite build --outDir dist/client && mv dist/client/index.html dist/client/index.html.template",
